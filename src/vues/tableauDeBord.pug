extends mssConnecte

block title
  -
    const estAdminOuSuperviseur = utilisateurConnecte && (utilisateurConnecte.estSuperviseur || utilisateurConnecte.estAdmin)
  title #{estAdminOuSuperviseur ? 'Services' : 'Tableau de bord'} | MonServiceSécurisé

block append styles
  +feuilleDeStyleAvecVersion('/statique/assets/styles/tiroir.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/formulaire.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/modules/selectize.css')

block append scripts
  +composantSvelte('tableauDeBord.js')
  +composantSvelte('explicationNouveauReferentiel.js')
  +composantSvelte('explicationUtilisationMFA.js')
  +donneesPartagees('utilisateur-connecte', {estSuperviseur: utilisateurConnecte && utilisateurConnecte.estSuperviseur, estAdmin: utilisateurConnecte && utilisateurConnecte.estAdmin, prenomNom: utilisateurConnecte.prenomNom, aDejaVuEntierementVisiteGuidee: etatVisiteGuidee.dejaTerminee})
  +donneesPartagees('avec-gestion-organisations', featureFlags.avecGestionDesOrganisations)
  +donneesPartagees('affiche-explication-nouveau-referentiel', afficheExplicationNouveauReferentiel)
  +donneesPartagees('affiche-explication-utilisation-mfa', afficheExplicationUtilisationMFA)
  +moduleAvecVersion('/statique/tableauDeBord.mjs')

block main
  #tableau-de-bord
  #rapport-televersement
  #explication-nouveau-referentiel
  #explication-utilisation-mfa