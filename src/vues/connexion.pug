extends ./mss
include ./fragments/header

block append styles
    +feuilleDeStyleAvecVersion('/statique/assets/styles/connexion.css')
    +feuilleDeStyleAvecVersion('/statique/assets/styles/formulaire.css')

block append scripts
    +composantSvelte('connexion.js')
    +donneesPartagees('url-redirection', {urlRedirection})

block header
    +header(avertissementMaintenance, featureFlags, true, '/', "Retour à l'accueil du site MonServiceSécurisé - République Française", true)

block main
    #conteneur-connexion

    +moduleAvecVersion('/statique/connexion.mjs')
