extends mssConnecte

block append styles
  +feuilleDeStyleAvecVersion('/statique/assets/styles/pagesService.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/tiroir.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/modules/selectize.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/formulaire.css')
  +feuilleDeStyleAvecVersion('/statique/assets/styles/homologation/formulaire.css')

block append scripts
  +moduleAvecVersion('/statique/scripts/parcoursService.mjs')
  +moduleAvecVersion('/statique/service/bandeauReferentielV2.js')(id='bandeau-referentiel-v2', data-version-service=service.version())
  +composantSvelte('menuNavigationService.js')
  +composantSvelte('bandeauReferentielV2.js')
  +composantSvelte('entetePageService.js')
  +donneesPartagees('autorisations-service', autorisationsService)
  +donneesPartagees('etape-active', etapeActive)
  -
    const nomService = service.nomService();
    const nomOrganisationResponsable = service.descriptionService?.organisationResponsable?.nom ?? '';
  +donneesPartagees('service', { nomService, nomOrganisationResponsable })
  +donneesPartagees('donnees-indice-cyber', {
    indiceCyber: service.indiceCyber().total,
    noteMax: referentiel.indiceCyberNoteMax()
  })
  +donneesPartagees('donnees-indice-cyber-personnalise', { indiceCyberPersonnalise: service.indiceCyberPersonnalise().total })

block header-complementaire
  #conteneur-bandeau-referentiel-v2
  #entete-page-service

block main
  #menu-navigation-service

  .marges-fixes.page-service(data-id-service=service.id)
      .zone-principale
        block zone-principale
          .formulaire
            .conteneur-entete
              .avancement-etape
                block avancement-etape
              .titre.titre-page
                block titre
              .etapier
                block etapier
              .sous-titre
                block sous-titre
            .conteneur-page-formulaire
              block modale
              block formulaire