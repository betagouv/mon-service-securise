extends mssDeconnecte

block title
  title Formez-vous à l'homologation de sécurité | MonServiceSécurisé

block variables
  - const meta_description = "En 2 ateliers pratiques, prenez en main MonServiceSécurisé et devenez autonome sur toute la démarche d'homologation de sécurité."

block append styles
  link(href="/statique/assets/styles/landing.css", rel="stylesheet")
  link(href="/statique/assets/styles/formezVous.css", rel="stylesheet")

block main
  .landing(data-themeable="true")
    lab-anssi-bandeau-page(
      titre="Formez-vous à l'homologation de sécurité"
      description="En 2 ateliers pratiques, prenez en main MonServiceSécurisé et devenez autonome sur toute la démarche d’homologation, de l'évaluation de votre système jusqu'au dossier d'homologation prêt à signer."
      url-image="/statique/assets/images/formation/illustration_hero.svg"
      inverse
    )
      dsfr-button(
        slot="buttonsgroup"
        label="M'inscrire à la formation"
        markup="a"
        href="https://app.livestorm.co/lab-anssi/formation-monservicesecurise-declarer-son-premier-service-numerique"
        target="_blank"
        centered
      )
      dsfr-button(
        slot="buttonsgroup"
        label="Voir le déroulé"
        kind="secondary"
        markup="a"
        href="#ateliers"
        centered
      )

    .bloc-contenu.bloc-public
      dsfr-container
        .conteneur-colonnes.inverse
          .principale
            -
              const publicsVises = ['Ministères', 'Établissements publics', 'Collectivités', 'GIP', 'Prestataires']
            dsfr-tags-group(
              tags=JSON.stringify(publicsVises.map((label) => ({ label })))
              size="md"
              group-markup="ul"
            )
            h2.titre Agent public ou prestataire du secteur public ?
            .corps
              p.description
                | Cette formation est faite pour vous !
                br
                | Que vous soyez chef de projet, référent numérique, RSSI ou simplement en charge d'un service à homologuer, nous vous accompagnons pas à pas.
              p.description
                strong Pas besoin d'être expert en cybersécurité.
          figure.secondaire
            img.illustration(
              src="/statique/assets/images/formation/illustration_public.png"
              alt=""
            )

    .bloc-contenu.bloc-chiffres
      dsfr-container
        -
          const chiffresCles = [
            { valeur: '1 000 personnes', libelle: 'déjà formées !' },
            { valeur: '97 %', libelle: 'de satisfaction !' },
            { valeur: '2 ateliers', libelle: 'chaque mois !' },
          ]
        ul.chiffres
          each chiffre in chiffresCles
            li.chiffre
              p.valeur= chiffre.valeur
              p.libelle= chiffre.libelle

    .bloc-contenu.bloc-competences
      dsfr-container
        .entete
          dsfr-badge(label="À la clé" type="accent" accent="green-menthe")
          h2.titre Vous repartez enfin à l'aise avec l'homologation
          p.description La démarche d’homologation qui vous semblait complexe devient claire, structurée et pilotable, avec un dossier en main et une équipe embarquée.
        .competences
          p.introduction 6 compétences concrètes, applicables directement sur votre périmètre.
          -
            const competences = [
              { titre: "Comprendre l'homologation", description: "Découvrez et expliquez la démarche d'homologation." },
              { titre: 'Évaluer les besoins', description: 'Référencez votre projet et identifiez ses besoins de sécurité.' },
              { titre: 'Appliquer les mesures', description: 'Mettez en œuvre et suivez les mesures ANSSI adaptées.' },
              { titre: 'Générer le dossier', description: "Créez un dossier d'homologation prêt à être utilisé." },
              { titre: 'Collaborer efficacement', description: 'Impliquez toutes les parties prenantes en un seul endroit.' },
              { titre: 'Piloter vos SI', description: "Suivez l'ensemble de vos systèmes d'information depuis un tableau de bord unique." },
            ]
          ul.cartes
            each competence in competences
              li
                dsfr-card(
                  title=competence.titre
                  has-description
                  description=competence.description
                  markup="h3"
                  size="sm"
                  no-link
                )
        .actions
          dsfr-button(
            label="Réserver ma place"
            markup="a"
            href="https://app.livestorm.co/lab-anssi/formation-monservicesecurise-declarer-son-premier-service-numerique"
            target="_blank"
            has-icon
            icon="calendar-event-line"
            icon-place="left"
          )
